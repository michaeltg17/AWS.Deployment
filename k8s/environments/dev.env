# per-environment, non-secret values. One file per env (dev.env, qa.env, prod.env).
# After `terraform apply`, set DOMAIN to the control node public IP (dev)
# or the real domain (qa/prod).

ENV=dev
# control node public IP from: terraform output -raw control_public_ip
DOMAIN=
# base URL the React app calls at runtime (plain http in dev - no TLS yet)
# e.g. API_URL=http://18.198.32.10/api
API_URL=http://<CTRL_IP>/api

# image tags - one build of each app, tagged <sha7> in CI
API_IMAGE_TAG=latest
REACT_IMAGE_TAG=latest
MIGRATIONS_IMAGE_TAG=latest
