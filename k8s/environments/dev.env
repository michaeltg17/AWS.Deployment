# per-environment, non-secret values. One file per env (dev.env, qa.env, prod.env).
# After `terraform apply`, set DOMAIN to the control node public IP (dev)
# or the real domain (qa/prod).

ENV=dev
# control node public IP from: terraform output -raw control_public_ip
DOMAIN=100.31.195.110
# Server-side base URL the React app's SSR (/auth/me prefetch) and the /api
# proxy route fetch. Must be reachable FROM the react pods: use the
# in-cluster api service, not the public NodePort (pod -> own node public
# IP NodePort hairpings and black-holes). Browsers use the relative /api
# path, so the public URL never reaches them.
API_URL=http://api:80/api

# image tags - one build of each app, tagged <sha7> in CI
API_IMAGE_TAG=latest
REACT_IMAGE_TAG=latest
MIGRATIONS_IMAGE_TAG=latest
