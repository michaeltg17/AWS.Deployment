# per-environment, non-secret values. One file per env (dev.env, qa.env, prod.env).
# Copy to dev.env and fill in:  cp dev.env.example dev.env
# dev.env (and dev.secrets.env) are gitignored.

ENV=dev
# Server-side base URL the React pod fetches (SSR prefetch + /api proxy).
# Must be reachable FROM the pods: the in-cluster api service. Browsers never
# see this value; they use the relative /api path through the ALB.
API_URL=http://api:80/api
# base URL of the image API this env's Template.Api calls (required API setting)
IMAGE_API_URL=
# RDS PostgreSQL private endpoint:  terraform output -raw rds_endpoint
RDS_ENDPOINT=
# RDS master username:             terraform output -raw db_user
DB_USER=

# image tags - one build of each app, tagged <sha7> in CI
API_IMAGE_TAG=latest
REACT_IMAGE_TAG=latest
MIGRATIONS_IMAGE_TAG=latest
