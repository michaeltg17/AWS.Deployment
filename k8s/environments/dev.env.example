# per-environment, non-secret values. One file per env (dev.env, qa.env, prod.env).
# Copy to dev.env and fill in:  cp dev.env.example dev.env
# dev.env (and dev.secrets.env) are gitignored.

ENV=dev
# control node public IP from: terraform output -raw control_public_ip
DOMAIN=
# Server-side base URL the React pod fetches (SSR /auth/me prefetch + /api
# proxy). Must be reachable FROM the pods: use the in-cluster api service,
# not the public NodePort (pod -> own node public IP hairpins/black-holes).
# Browsers never see this value; they use the relative /api path.
API_URL=http://api:80/api
# base URL of the image API this env's AWS.Api calls (required API setting)
IMAGE_API_URL=

# image tags - one build of each app, tagged <sha7> in CI
API_IMAGE_TAG=latest
REACT_IMAGE_TAG=latest
MIGRATIONS_IMAGE_TAG=latest
